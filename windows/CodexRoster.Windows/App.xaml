<Application
    x:Class="CodexRoster.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexRoster.Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="RosterPageBrush" Color="#F4F6FB" />
            <SolidColorBrush x:Key="RosterInkBrush" Color="#1C2434" />
            <SolidColorBrush x:Key="RosterMutedBrush" Color="#586477" />
            <SolidColorBrush x:Key="RosterAccentBrush" Color="#5046E5" />
            <SolidColorBrush x:Key="RosterAccentSoftBrush" Color="#E9E7FF" />
            <SolidColorBrush x:Key="RosterPanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RosterPanelStrokeBrush" Color="#DCE2ED" />

            <Style x:Key="RosterSurfaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource RosterPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RosterPanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
            <Style x:Key="RosterPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource RosterAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>
            <Style x:Key="RosterSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource RosterPanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
