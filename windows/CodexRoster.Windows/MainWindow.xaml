<Window
    x:Class="CodexRoster.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CodexRoster.Windows.Models"
    Title="Codex Roster">
    <Grid Background="{StaticResource RosterPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource RosterPanelBrush}" BorderBrush="{StaticResource RosterPanelStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="1440" Margin="32,16" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource RosterAccentBrush}">
                        <FontIcon Glyph="&#xE77B;" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Codex Roster" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                        <TextBlock Text="Quản lý phiên Codex trên thiết bị này" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource RosterSecondaryButtonStyle}" Click="RefreshQuota_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <SymbolIcon Symbol="Refresh" />
                            <TextBlock Text="Cập nhật quota" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RosterPrimaryButtonStyle}" Click="AddAccount_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Thêm tài khoản" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RosterSecondaryButtonStyle}" Click="AccountMenu_Click" ToolTipService.ToolTip="Tác vụ khác">
                        <SymbolIcon Symbol="More" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FBFCFF" BorderBrush="{StaticResource RosterPanelStrokeBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="18,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Không gian làm việc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                        <TextBlock Text="Tổng quan" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Row="1" Margin="0,18,0,12" SelectedIndex="0" SelectionChanged="AccountSort_SelectionChanged">
                        <ComboBoxItem Content="Gói → quota" />
                        <ComboBoxItem Content="Quota → gói" />
                        <ComboBoxItem Content="Tên hiển thị" />
                        <ComboBoxItem Content="Email" />
                    </ComboBox>
                    <StackPanel Grid.Row="2" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="#22A06B" VerticalAlignment="Center" />
                            <TextBlock Text="Tài khoản đã lưu" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{StaticResource RosterInkBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <ListView ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}" SelectionMode="None" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AccountItem">
                                    <Border Padding="10" CornerRadius="10" Background="{StaticResource RosterPageBrush}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource RosterInkBrush}" />
                                                <TextBlock Text="{x:Bind SidebarStatus}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource RosterMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource RosterSecondaryButtonStyle}" Padding="7" Tag="{x:Bind}" Click="AccountActions_Click" ToolTipService.ToolTip="Tác vụ tài khoản">
                                                <SymbolIcon Symbol="More" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="Chưa có account. Thêm tài khoản hoặc dùng dữ liệu mẫu để kiểm thử giao diện." TextWrapping="Wrap" Foreground="{StaticResource RosterMutedBrush}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.EmptyAccountsVisibility, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Row="4" Spacing="8">
                        <Button Content="Thêm tài khoản" Style="{StaticResource RosterPrimaryButtonStyle}" Click="AddAccount_Click" HorizontalAlignment="Stretch" />
                        <Button Content="Dùng dữ liệu mẫu" Style="{StaticResource RosterSecondaryButtonStyle}" Click="LoadDemoData_Click" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SizeChanged="ContentScrollViewer_SizeChanged">
            <Grid x:Name="ContentLayout" Margin="26,22,28,24" MinWidth="960" MinHeight="640" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Warning"
                    Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="True"
                    CloseButtonClick="ErrorInfoBar_CloseClick" />

                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsPendingLogin, Mode=OneWay}"
                    Severity="Informational"
                    Title="Đang tự động hoàn tất đăng nhập"
                    Message="{x:Bind ViewModel.LoginStatus, Mode=OneWay}"
                    IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button Content="Hủy và khôi phục phiên" Click="CancelPendingLogin_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsShowingDemoData, Mode=OneWay}"
                    Severity="Informational"
                    Title="Đang xem dữ liệu mẫu"
                    Message="Ba tài khoản minh họa chỉ phục vụ kiểm thử UI. Làm mới hoặc nhập dữ liệu thật để quay về roster trên máy." />
                </StackPanel>

                <Border Grid.Row="1" Background="#FBFAFF" BorderBrush="#D9D6FF" BorderThickness="1" CornerRadius="16" Padding="20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="TÀI KHOẢN ĐANG DÙNG" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentAccountLabel, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentAccountDetail, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RosterMutedBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="18,0,0,0" BorderBrush="{StaticResource RosterPanelStrokeBrush}" BorderThickness="1,0,0,0">
                            <StackPanel Spacing="5">
                                <TextBlock Text="ĐÃ LƯU" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SavedAccountCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                <TextBlock Text="phiên sẵn sàng quản lý" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="18,0,0,0" BorderBrush="{StaticResource RosterPanelStrokeBrush}" BorderThickness="1,0,0,0">
                            <StackPanel Spacing="5">
                                <TextBlock Text="CÓ THỂ CHUYỂN" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ReadyAccountCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                <TextBlock Text="quota còn hiệu lực" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tài khoản" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                <TextBlock Text="Quota, thời điểm reset và thao tác chuyển phiên." Foreground="{StaticResource RosterMutedBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource RosterSurfaceCardStyle}" Padding="22" Visibility="{x:Bind ViewModel.EmptyAccountsVisibility, Mode=OneWay}">
                            <StackPanel Spacing="10" HorizontalAlignment="Left">
                                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource RosterAccentSoftBrush}">
                                    <SymbolIcon Symbol="Contact" Foreground="{StaticResource RosterAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                    <TextBlock Text="Chưa có tài khoản nào" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                    <TextBlock Text="Bắt đầu bằng cách đăng nhập một tài khoản OpenAI. Roster sẽ bảo toàn phiên cũ và chỉ lưu phiên mới sau khi bạn xác nhận." TextWrapping="Wrap" MaxWidth="520" Foreground="{StaticResource RosterMutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource RosterPrimaryButtonStyle}" Click="AddAccount_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <SymbolIcon Symbol="Add" />
                                                <TextBlock Text="Thêm tài khoản đầu tiên" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Dùng dữ liệu mẫu" Style="{StaticResource RosterSecondaryButtonStyle}" Click="LoadDemoData_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Dữ liệu mẫu chỉ hiển thị trong cửa sổ này và không lưu vào Codex." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False" Visibility="{x:Bind ViewModel.AccountsListVisibility, Mode=OneWay}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AccountItem">
                                    <Border Style="{StaticResource RosterSurfaceCardStyle}" Margin="0,0,0,8" Padding="16" Opacity="{x:Bind RowOpacity}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="176" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" VerticalAlignment="Center" />
                                                    <Border Padding="7,3" CornerRadius="7" Background="{StaticResource RosterAccentBrush}" Visibility="{x:Bind ActiveBadgeVisibility}">
                                                        <TextBlock Text="Đang dùng" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <Border Padding="7,3" CornerRadius="7" Background="{StaticResource RosterAccentSoftBrush}" Visibility="{x:Bind ArchivedBadgeVisibility}">
                                                        <TextBlock Text="Đã lưu trữ" Foreground="{StaticResource RosterAccentBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Email}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind PlanLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                    <TextBlock Text="{x:Bind QuotaLabel}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                                    <TextBlock Text="quota" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                                </StackPanel>
                                                <ProgressBar Value="{x:Bind QuotaPercent}" Maximum="100" Visibility="{x:Bind QuotaMeterVisibility}" Height="5" />
                                                <TextBlock Text="{x:Bind SecondaryQuotaLabel}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" Visibility="{x:Bind SecondaryQuotaVisibility}" />
                                                <TextBlock Text="{x:Bind ResetLabel}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="Đang dùng" Style="{StaticResource RosterSecondaryButtonStyle}" IsEnabled="False" Visibility="{x:Bind ActiveStateVisibility}" />
                                                <Button Content="Chuyển" Style="{StaticResource RosterPrimaryButtonStyle}" Tag="{x:Bind}" Click="ActivateAccount_Click" Visibility="{x:Bind SwitchVisibility}" />
                                                <Button Content="Đăng nhập lại" Style="{StaticResource RosterSecondaryButtonStyle}" Tag="{x:Bind}" Click="ReloginAccount_Click" Visibility="{x:Bind ReloginVisibility}" />
                                                <Button Style="{StaticResource RosterSecondaryButtonStyle}" Tag="{x:Bind}" Click="AccountActions_Click" ToolTipService.ToolTip="Tùy chọn tài khoản">
                                                    <SymbolIcon Symbol="More" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <Border Style="{StaticResource RosterSurfaceCardStyle}" Padding="18">
                            <StackPanel Spacing="9">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Tự động chuyển" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                    <TextBlock Text="Chỉ chuyển khi quota đã xác minh; tác vụ Codex đang chạy luôn được bảo vệ." TextWrapping="Wrap" Foreground="{StaticResource RosterMutedBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Header="Tự động làm mới quota" IsOn="{x:Bind ViewModel.AutoQuotaRefresh, Mode=TwoWay}" Toggled="AutoQuotaRefresh_Toggled" />
                                <ToggleSwitch Header="Tự động chuyển khi hết quota" IsOn="{x:Bind ViewModel.AutoSwitchWhenExhausted, Mode=TwoWay}" Toggled="AutoSwitchWhenExhausted_Toggled" IsEnabled="{x:Bind ViewModel.CanChangeAutoSwitch, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.AutoSwitchStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                <Button Content="Kiểm tra ngay" Style="{StaticResource RosterSecondaryButtonStyle}" Click="RunAutoSwitchCheck_Click" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.AutoSwitchActionsVisibility, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanChangeAutoSwitch, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RosterSurfaceCardStyle}" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Hoạt động" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Hôm nay" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.TokenUsageToday, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="7 ngày" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.TokenUsageLast7Days, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RosterInkBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.OpenAiStatusSummary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ResetOutlookSummary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RosterMutedBrush}" />
                                <Button Content="Cập nhật hoạt động &amp; dịch vụ" Style="{StaticResource RosterSecondaryButtonStyle}" Click="RefreshInsights_Click" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RosterSurfaceCardStyle}">
                            <Expander Header="Phiên &amp; sao lưu" Padding="16,12">
                                <StackPanel Spacing="8" Margin="0,10,0,0">
                                    <TextBlock Text="Nhập phiên cũ hoặc chuyển roster bằng bản sao lưu mã hóa." TextWrapping="Wrap" Foreground="{StaticResource RosterMutedBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Content="Nhập từ file JSON…" Style="{StaticResource RosterSecondaryButtonStyle}" Click="ImportJson_Click" HorizontalAlignment="Stretch" />
                                    <Button Content="Lưu phiên hiện tại" Style="{StaticResource RosterSecondaryButtonStyle}" Click="SaveCurrent_Click" HorizontalAlignment="Stretch" />
                                    <Button Content="Xuất bản sao lưu mã hóa" Style="{StaticResource RosterSecondaryButtonStyle}" Click="ExportBackup_Click" HorizontalAlignment="Stretch" />
                                    <Button Content="Nhập bản sao lưu mã hóa" Style="{StaticResource RosterSecondaryButtonStyle}" Click="ImportBackup_Click" HorizontalAlignment="Stretch" />
                                    <Button Content="Hủy thêm tài khoản" Style="{StaticResource RosterSecondaryButtonStyle}" Click="CancelPendingLogin_Click" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.PendingLoginVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
    </Grid>
</Window>
